DEBUG=True

# Signs session cookies and password-reset tokens.
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me

# Encrypts every seller's provider credentials.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# BACK THIS UP SEPARATELY FROM THE DATABASE. It is not stored in the database,
# and a restore without it leaves every seller's Payme / Click / Uzum /
# Paynet / Octo keys permanently unreadable — the site comes back looking
# perfectly healthy and nobody can take a payment. See deploy/RESTORE.md.
FIELD_ENCRYPTION_KEY=change-me

ALLOWED_HOSTS=127.0.0.1,localhost

# Production only (PostgreSQL). Dev falls back to sqlite.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Absolute base for the callback URLs handed to a provider. Must be the real
# public address in production, or Octo will send its callbacks nowhere.
# SITE_URL=https://tapcon.uz
# CSRF_TRUSTED_ORIGINS=https://tapcon.uz,https://www.tapcon.uz

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Eskiz SMS — production only. Dev prints the OTP to the console.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546

SUPPORT_PHONE=+998 90 000 00 00
SUPPORT_TELEGRAM=https://t.me/tapcon_admin

# --- backups (set in the cron entry, not here) ---------------------------
# BACKUP_PASSPHRASE belongs in a password manager, NOT in this file: it
# encrypts the backup copy of this file, so keeping both on one server means
# one stolen machine gives up both halves.
# BACKUP_REMOTE=b2:tapcon-backups
