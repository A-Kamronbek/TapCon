# This repository is edited on Windows and deployed on Linux.
#
# Anything the server *executes* must arrive with LF endings. A shell script
# checked out with CRLF fails with "bad interpreter: /bin/bash^M", which is a
# confusing way to discover that a backup cron job has never once run.
*.sh        text eol=lf
*.service   text eol=lf
*.conf      text eol=lf
Makefile    text eol=lf

# Binary assets git must not try to translate.
*.woff2     binary
*.png       binary
*.jpg       binary
*.ico       binary
*.docx      binary
*.mo        binary
